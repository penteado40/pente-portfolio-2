# Copy to .env.local and fill in. Both are read only on the server.

# Base URL of the external API that stores contact messages and testimonials,
# without a trailing slash. Without it, the contact and testimonial forms
# answer 500 and the Audio persona shows no Testimonials; the rest of the
# site works.
API_URL=https://api.example.com

# Sent to that API as the X-API-Key header.
API_KEY=
